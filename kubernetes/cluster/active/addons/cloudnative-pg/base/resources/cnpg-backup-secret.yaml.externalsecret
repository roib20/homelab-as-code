# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: cnpg-backup-secret
  namespace: cnpg-system
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: cnpg-backup-secret
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      metadata:
        annotations:
          reflector.v1.k8s.emberstack.com/reflection-allowed: "true"
          reflector.v1.k8s.emberstack.com/reflection-allowed-namespaces: "bookorbit,floppy,immich,miniflux,opengist,outline,pinepods,seerr,servarr,streamystats,tandoor"
          reflector.v1.k8s.emberstack.com/reflection-auto-enabled: "true"
          reflector.v1.k8s.emberstack.com/reflection-auto-namespaces: "bookorbit,floppy,immich,miniflux,opengist,outline,pinepods,seerr,servarr,streamystats,tandoor"
      data:
        AWS_ACCESS_KEY_ID: "{{ .AWS_ACCESS_KEY_ID }}"
        AWS_ENDPOINT_URL: "{{ .AWS_ENDPOINT_URL }}"
        AWS_REGION: auto
        AWS_SECRET_ACCESS_KEY: "{{ .AWS_SECRET_ACCESS_KEY }}"
  data:
    - secretKey: AWS_ACCESS_KEY_ID
      remoteRef:
        key: r2-backup-access-key-id
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: AWS_ENDPOINT_URL
      remoteRef:
        key: r2-backup-endpoint
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: AWS_SECRET_ACCESS_KEY
      remoteRef:
        key: r2-backup-secret-access-key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
