---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: flare-secrets
  namespace: flare
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: flare-secrets
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    - secretKey: NEXTAUTH_SECRET
      remoteRef:
        key: flare-nextauth-secret
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: BOOTSTRAP_ADMIN_NAME
      remoteRef:
        key: flare-bootstrap-admin-name
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: BOOTSTRAP_ADMIN_EMAIL
      remoteRef:
        key: flare-bootstrap-admin-email
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: BOOTSTRAP_ADMIN_PASSWORD
      remoteRef:
        key: flare-bootstrap-admin-password
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
