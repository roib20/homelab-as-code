# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
# Generate DB_ENCRYPTION_KEY and SESSION_SECRET with:
# openssl rand -hex 32
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: yuvomi
  namespace: yuvomi
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: yuvomi
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    - secretKey: DB_ENCRYPTION_KEY
      remoteRef:
        key: yuvomi-db_encryption_key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: SESSION_SECRET
      remoteRef:
        key: yuvomi-session_secret
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
