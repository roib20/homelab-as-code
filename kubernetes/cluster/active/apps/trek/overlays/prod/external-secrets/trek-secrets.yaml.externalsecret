# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: trek-secrets
  namespace: trek
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: trek-secrets
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    - secretKey: CARTO_API_KEY
      remoteRef:
        key: trek-carto-api-key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    # At-rest encryption key for stored secrets (API keys, MFA, SMTP, OIDC).
    - secretKey: ENCRYPTION_KEY
      remoteRef:
        key: trek-encryption-key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
