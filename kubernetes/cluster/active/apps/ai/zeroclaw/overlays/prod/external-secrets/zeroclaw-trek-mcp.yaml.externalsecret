# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
# Enable the MCP addon under `Admin -> Addons -> MCP` (required, or /mcp
# returns 403), then create the token under your user
# `Settings -> Integrations -> MCP Configuration -> API Tokens`.
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: zeroclaw-trek-mcp
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: zeroclaw-trek-mcp
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      data:
        ZEROCLAW_mcp__servers__trek_mcp__headers__authorization: 'Bearer {{ .token | trim }}'
  data:
    - secretKey: token
      remoteRef:
        key: zeroclaw-trek-token
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
