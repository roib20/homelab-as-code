# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: zeroclaw-calendar-mcp
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: zeroclaw-calendar-mcp
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    # Published ICS feed URL for the read-only calendar (bearer credential).
    - secretKey: ICS_URL
      remoteRef:
        key: zeroclaw-calendar-mcp-ics-url
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
