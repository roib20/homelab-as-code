# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
# Create the token in Yuvomi: `Settings -> Administration -> API access`
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: zeroclaw-yuvomi-mcp
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: zeroclaw-yuvomi-mcp
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      data:
        ZEROCLAW_mcp__servers__yuvomi_mcp__headers__authorization: 'Bearer {{ .token | trim }}'
  data:
    - secretKey: token
      remoteRef:
        key: zeroclaw-yuvomi-token
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
