# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
# Reuses the cluster-scoped seerr-servarr-secret-store, which already grants
# external-secrets `get` on servarr/servarr-secrets.
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: zeroclaw-servarr-secrets
spec:
  refreshInterval: 5m
  secretStoreRef:
    name: seerr-servarr-secret-store
    kind: ClusterSecretStore
  target:
    name: zeroclaw-servarr-secrets
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    - secretKey: prowlarr_api_key
      remoteRef:
        key: servarr-secrets
        property: prowlarr_api_key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: radarr_hd_api_key
      remoteRef:
        key: servarr-secrets
        property: radarr_hd_api_key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: radarr_uhd_api_key
      remoteRef:
        key: servarr-secrets
        property: radarr_uhd_api_key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: sonarr_hd_api_key
      remoteRef:
        key: servarr-secrets
        property: sonarr_hd_api_key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: sonarr_uhd_api_key
      remoteRef:
        key: servarr-secrets
        property: sonarr_uhd_api_key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
