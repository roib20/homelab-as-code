# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: zeroclaw-garmin-mcp
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: zeroclaw-garmin-mcp
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    - secretKey: GARMIN_EMAIL
      remoteRef:
        key: zeroclaw-garmin-email
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: GARMIN_PASSWORD
      remoteRef:
        key: zeroclaw-garmin-password
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
