# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
# Create the API key under `Settings -> API Keys` in Miniflux.
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: zeroclaw-miniflux-mcp
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: zeroclaw-miniflux-mcp
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      data:
        MINIFLUX_API_KEY: '{{ .MINIFLUX_API_KEY | trim }}'
        MCP_AUTH_TOKEN: '{{ .mcp_auth_token | trim }}'
        ZEROCLAW_mcp__servers__miniflux__headers__authorization: 'Bearer {{ .mcp_auth_token | trim }}'
  data:
    - secretKey: MINIFLUX_API_KEY
      remoteRef:
        key: zeroclaw-miniflux-api-key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: mcp_auth_token
      remoteRef:
        key: zeroclaw-miniflux-mcp-auth-token
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
