# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
# Create an API key under `Settings -> API Keys` in Karakeep.
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: zeroclaw-karakeep-mcp
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: zeroclaw-karakeep-mcp
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    - secretKey: KARAKEEP_API_KEY
      remoteRef:
        key: zeroclaw-karakeep-api-key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
