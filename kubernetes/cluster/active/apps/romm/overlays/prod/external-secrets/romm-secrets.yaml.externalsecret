# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: romm-secrets
  namespace: romm
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: romm-secrets
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    - secretKey: IGDB_CLIENT_ID
      remoteRef:
        key: romm-igdb-client-id
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: IGDB_CLIENT_SECRET
      remoteRef:
        key: romm-igdb-client-secret
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: RETROACHIEVEMENTS_API_KEY
      remoteRef:
        key: romm-retroachievements-api-key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    # openssl rand -hex 32
    - secretKey: ROMM_AUTH_SECRET_KEY
      remoteRef:
        key: romm-auth-secret-key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: SCREENSCRAPER_PASSWORD
      remoteRef:
        key: romm-screenscraper-password
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: SCREENSCRAPER_USER
      remoteRef:
        key: romm-screenscraper-user
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: STEAMGRIDDB_API_KEY
      remoteRef:
        key: romm-steamgriddb-api-key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
