# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: bazarr-jellyfin-secret
  namespace: servarr
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: bazarr-jellyfin-secret
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    - secretKey: DYNACONF_jellyfin__apikey
      remoteRef:
        key: bazarr-jellyfin-secret
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
