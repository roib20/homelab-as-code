# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: streamystats-secrets
  namespace: streamystats
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: streamystats-secrets
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    # openssl rand -hex 32
    - secretKey: SESSION_SECRET
      remoteRef:
        key: streamystats-session-secret
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    # openssl rand -base64 32
    - secretKey: NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
      remoteRef:
        key: streamystats-encryption-key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
