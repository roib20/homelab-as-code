# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: floppy-app-secrets
  namespace: floppy
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: floppy-app-secrets
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    # Hardcover API token.
    - secretKey: HARDCOVER_API
      remoteRef:
        key: HARDCOVER_TOKEN
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    # IGDB client credentials.
    - secretKey: IGDB_ID
      remoteRef:
        key: romm-igdb-client-id
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: IGDB_SECRET
      remoteRef:
        key: romm-igdb-client-secret
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    # ScreenScraper account credentials.
    - secretKey: SCREENSCRAPER_SSID
      remoteRef:
        key: romm-screenscraper-user
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: SCREENSCRAPER_SSPASSWORD
      remoteRef:
        key: romm-screenscraper-password
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    # Django SECRET_KEY (signs sessions/cookies); rotating it invalidates sessions.
    # Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
    - secretKey: SECRET
      remoteRef:
        key: floppy-secret
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    # SteamGridDB API key.
    - secretKey: STEAMGRIDDB_API_KEY
      remoteRef:
        key: romm-steamgriddb-api-key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    # TMDB v3 API Key (sent as ?api_key=), not the v4 Read Access Token.
    # From https://www.themoviedb.org/settings/api -> API Key
    - secretKey: TMDB_API
      remoteRef:
        key: floppy-tmdb-api-key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    # TheTVDB API key.
    - secretKey: TVDB_API_KEY
      remoteRef:
        key: TVDB_API_KEY
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
