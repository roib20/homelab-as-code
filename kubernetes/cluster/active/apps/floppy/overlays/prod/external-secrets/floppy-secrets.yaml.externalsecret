# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: floppy-secrets
  namespace: floppy
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: floppy-secrets
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    # Django SECRET_KEY (signs sessions/cookies); rotating it invalidates sessions.
    # Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
    - secretKey: SECRET
      remoteRef:
        key: floppy-secret
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    # TMDB v3 API Key (sent as ?api_key=), not the v4 Read Access Token.
    # From https://www.themoviedb.org/settings/api -> API Key
    - secretKey: TMDB_API
      remoteRef:
        key: floppy-tmdb-api-key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    # Per-user Floppy API tokens for the MCP sidecars (Settings -> Integrations).
    - secretKey: FLOPPY_TOKEN_1
      remoteRef:
        key: floppy-mcp-token-1
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: FLOPPY_TOKEN_2
      remoteRef:
        key: floppy-mcp-token-2
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
