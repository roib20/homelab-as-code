# ExternalSecret: https://external-secrets.io/latest/api/externalsecret/
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: papra-secrets
  namespace: papra
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: papra-secrets
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    # openssl rand -hex 48
    - secretKey: AUTH_SECRET
      remoteRef:
        key: papra-auth-secret
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    # openssl rand -hex 32
    - secretKey: DATABASE_ENCRYPTION_KEY
      remoteRef:
        key: papra-database-encryption-key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
