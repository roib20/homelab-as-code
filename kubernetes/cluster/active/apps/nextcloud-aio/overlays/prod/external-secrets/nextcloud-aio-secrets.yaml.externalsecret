---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: nextcloud-aio-secrets
  namespace: nextcloud
spec:
  # Database and shared keys must not change merely because the provider value changes.
  refreshPolicy: CreatedOnce
  secretStoreRef:
    name: bitwarden-secretsmanager
    kind: ClusterSecretStore
  target:
    name: nextcloud-aio-secrets
    creationPolicy: Orphan
    deletionPolicy: Retain
    template:
      engineVersion: v2
      type: Opaque
  dataFrom:
    - extract:
        key: nextcloud-aio-secrets
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
